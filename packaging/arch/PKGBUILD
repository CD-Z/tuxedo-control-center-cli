pkgbase=tuxedo-control-center-cli
pkgname=('tuxedo-control-center-cli' 'tuxedo-control-center-cli-ppd' 'tuxedo-control-center-cli-ui')
pkgver=3.0.11
pkgrel=2
pkgdesc='Headless TUXEDO Control Center daemon and command-line client'
arch=('x86_64')
url='https://tuxedocomputers.com'
license=('GPL3')
makedepends=('base-devel' 'git' 'nodejs>=24' 'npm' 'python' 'systemd')
# Supply a local archive with a top-level directory named tuxedo-control-center-cli-${pkgver}.
source=("${pkgbase}-${pkgver}.tar.gz")
sha256sums=('SKIP')

_runtime='/opt/tuxedo-control-center/resources/dist/tuxedo-control-center/data'

build() {
    cd "${srcdir}/${pkgbase}-${pkgver}"
    npm ci
    npm run build-prod
    npm run build-cli
    npm run esbuild-cli
    npm run electron-builder -- dir
}

package_tuxedo-control-center-cli() {
    pkgdesc='Headless TUXEDO Control Center daemon and command-line client'
    depends=('nodejs>=24' 'glibc' 'gcc-libs' 'systemd-libs' 'libxcrypt-compat' 'python' 'dbus' 'polkit' 'upower' 'systemd')
    optdepends=('tuxedo-drivers-dkms: TUXEDO hardware support through tuxedo-io')
    conflicts=('tuxedo-control-center' 'tuxedo-control-center-bin')
    # Stripping removes the embedded payload from the pkg executable.
    options=('!strip')

    cd "${srcdir}/${pkgbase}-${pkgver}"
    install -Dm755 "dist/tuxedo-control-center/data/service/tccd" "${pkgdir}${_runtime}/service/tccd"
    install -Dm755 "dist/tuxedo-control-center/data/cli/tcc-cli.cjs" "${pkgdir}${_runtime}/cli/tcc-cli.cjs"
    install -Dm755 'packaging/arch/tcc-cli' "${pkgdir}/usr/bin/tcc-cli"
    install -Dm755 'src/cameractrls/cameractrls.py' "${pkgdir}${_runtime}/camera/cameractrls.py"
    install -Dm644 'src/cameractrls/v4l2_kernel_names.json' "${pkgdir}${_runtime}/camera/v4l2_kernel_names.json"
    install -Dm644 'src/dist-data/tccd.service' "${pkgdir}/usr/lib/systemd/system/tccd.service"
    install -Dm644 'src/dist-data/tccd-sleep.service' "${pkgdir}/usr/lib/systemd/system/tccd-sleep.service"
    install -Dm644 'src/dist-data/com.tuxedocomputers.tccd.conf' "${pkgdir}/usr/share/dbus-1/system.d/com.tuxedocomputers.tccd.conf"
    install -Dm644 'src/dist-data/com.tuxedocomputers.tccd.policy' "${pkgdir}/usr/share/polkit-1/actions/com.tuxedocomputers.tccd.policy"
    install -Dm644 'src/udev/99-webcam.rules' "${pkgdir}/usr/lib/udev/rules.d/99-webcam.rules"
}

package_tuxedo-control-center-cli-ppd() {
    pkgdesc='Power-profiles-daemon compatible provider for TUXEDO Control Center'
    depends=("tuxedo-control-center-cli=${pkgver}-${pkgrel}")
    provides=('power-profiles-daemon')
    conflicts=('power-profiles-daemon' 'tlp-pd' 'tuned-ppd' 'tuxedo-power-profiles-adapter-git')

    cd "${srcdir}/${pkgbase}-${pkgver}"
    install -Dm644 'src/dist-data/org.freedesktop.UPower.PowerProfiles.service' "${pkgdir}/usr/share/dbus-1/system-services/org.freedesktop.UPower.PowerProfiles.service"
    install -Dm644 'src/dist-data/org.freedesktop.UPower.PowerProfiles.conf' "${pkgdir}/usr/share/dbus-1/system.d/org.freedesktop.UPower.PowerProfiles.conf"
    install -Dm644 'src/dist-data/org.freedesktop.UPower.PowerProfiles.policy' "${pkgdir}/usr/share/polkit-1/actions/org.freedesktop.UPower.PowerProfiles.policy"
}

package_tuxedo-control-center-cli-ui() {
    pkgdesc='Graphical TUXEDO Control Center application'
    depends=(
        "tuxedo-control-center-cli=${pkgver}-${pkgrel}"
        'gtk3'
        'nss'
        'nspr'
        'alsa-lib'
        'libxss'
        'libxtst'
        'libdrm'
        'libxkbcommon'
        'mesa'
        'libnotify'
        'libsecret'
        'at-spi2-core'
        'libayatana-appindicator'
        'xdg-utils'
    )
    optdepends=('tuxedo-control-center-cli-ppd: enable standard desktop power-mode integration')
    options=('!strip')

    cd "${srcdir}/${pkgbase}-${pkgver}"
    local appdir="${srcdir}/${pkgbase}-${pkgver}/dist/packages/linux-unpacked"
    [[ -x "${appdir}/tuxedo-control-center" ]]
    [[ -f "${appdir}/resources/app.asar" ]]
    [[ -f "${appdir}/chrome-sandbox" ]]
    [[ ! -e "${appdir}/resources/dist/tuxedo-control-center/data/service" ]]
    [[ ! -e "${appdir}/resources/dist/tuxedo-control-center/data/cli" ]]
    [[ ! -e "${appdir}/resources/dist/tuxedo-control-center/data/camera" ]]

    install -d "${pkgdir}/opt/tuxedo-control-center"
    cp -a "${appdir}/." "${pkgdir}/opt/tuxedo-control-center/"
    chmod 4755 "${pkgdir}/opt/tuxedo-control-center/chrome-sandbox"
    install -d "${pkgdir}/usr/bin"
    ln -s /opt/tuxedo-control-center/tuxedo-control-center "${pkgdir}/usr/bin/tuxedo-control-center"

    install -Dm644 'src/dist-data/tuxedo-control-center.desktop' "${pkgdir}/usr/share/applications/tuxedo-control-center.desktop"
    install -Dm644 'src/dist-data/tuxedo-control-center-tray.desktop' "${pkgdir}/etc/skel/.config/autostart/tuxedo-control-center-tray.desktop"
    install -Dm644 'src/dist-data/tuxedo-control-center_256.png' "${pkgdir}/usr/share/icons/hicolor/256x256/apps/tuxedo-control-center.png"
    install -Dm644 'src/dist-data/tuxedo-control-center_256.svg' "${pkgdir}/usr/share/icons/hicolor/scalable/apps/tuxedo-control-center.svg"
    install -Dm644 'src/dist-data/com.tuxedocomputers.tcc.metainfo.xml' "${pkgdir}/usr/share/metainfo/com.tuxedocomputers.tcc.metainfo.xml"
    install -Dm644 'src/dist-data/com.tuxedocomputers.tomte.policy' "${pkgdir}/usr/share/polkit-1/actions/com.tuxedocomputers.tomte.policy"
}
